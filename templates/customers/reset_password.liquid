<section class="page-hero"><div class="wrap" style="max-width:520px">
  <h1 class="display" style="font-size:clamp(40px,6vw,72px)">New <em>password.</em></h1>
  {%- form 'reset_customer_password', class: 'form', style: 'grid-template-columns:1fr' -%}
    {%- if form.errors -%}<p class="form-msg" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="sr" for="rp1">Password</label><input class="field" id="rp1" type="password" name="customer[password]" placeholder="New password" autocomplete="new-password">
    <label class="sr" for="rp2">Confirm</label><input class="field" id="rp2" type="password" name="customer[password_confirmation]" placeholder="Confirm password" autocomplete="new-password">
    <button class="btn btn-holo" type="submit">Reset password</button>
  {%- endform -%}
</div></section>
