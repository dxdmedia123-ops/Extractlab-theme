<section class="light sec" id="discovery">
  <div class="wrap">
    <div class="sec-head">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div>
      {%- if section.settings.lead != blank -%}<p class="lead" style="max-width:40ch">{{ section.settings.lead }}</p>{%- endif -%}
    </div>
    <div class="sets">
      {%- liquid
        if section.settings.products != blank
          assign list = section.settings.products
        elsif section.settings.collection != blank
          assign list = section.settings.collection.products
        else
          assign list = collections['discovery-perfume-oil-sets'].products
        endif
      -%}
      {%- for product in list limit: 6 -%}
        {%- capture notes -%}{% render 'product-notes', product: product %}{%- endcapture -%}
        <div class="set">
          <a class="card" href="{{ product.url }}">
            {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 900px) 33vw, 100vw' }}{%- else -%}{{ 'product-1' | placeholder_svg_tag }}{%- endif -%}
          </a>
          <h3>{{ product.title | remove: ' Discovery Set' | split: ' | ' | first }}</h3>
          {%- if notes != blank -%}<p>{{ notes }}</p>{%- else -%}<p>Three full-size 9ml perfume oils</p>{%- endif -%}
          <div class="row">
            <span class="price">{{ product.price | money }}{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}</span>
            {%- if product.available and product.has_only_default_variant -%}
              <button class="add" type="button" data-add="{{ product.selected_or_first_available_variant.id }}" data-title="{{ product.title | escape }}">Add set</button>
            {%- else -%}
              <a class="add" href="{{ product.url }}" style="display:inline-grid;place-items:center;text-decoration:none">View</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note_bold != blank -%}
      <div class="bundle-note"><b>{{ section.settings.note_bold }}</b><span>{{ section.settings.note }}</span></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Discovery sets",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Discovery sets" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Can't pick?" },
    { "type": "text", "id": "heading_em", "label": "Heading (italic)", "default": "Try three." },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "Three full-size 9ml oils, curated by mood. The easiest way to find the one you'll reorder." },
    { "type": "product_list", "id": "products", "label": "Sets", "limit": 6 },
    { "type": "collection", "id": "collection", "label": "Or a collection" },
    { "type": "text", "id": "note_bold", "label": "Offer (bold)", "default": "BUY 6, SAVE UP TO 15%" },
    { "type": "text", "id": "note", "label": "Offer text", "default": "Mix any six products. The bundle discount applies automatically at checkout." }
  ],
  "presets": [{ "name": "Discovery sets" }]
}
{% endschema %}
