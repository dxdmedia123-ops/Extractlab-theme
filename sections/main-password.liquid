<section class="page-hero" style="min-height:70vh;display:grid;place-items:center;text-align:center">
  <div class="wrap" style="align-items:center">
    <img src="{{ 'wordmark.png' | asset_url }}" alt="{{ shop.name }}" width="1058" height="726" style="width:160px;height:auto">
    <h1 class="display" style="font-size:clamp(40px,6vw,80px)">Opening <em>soon.</em></h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'form', style: 'max-width:420px;width:100%;grid-template-columns:1fr' -%}
      {%- if form.errors -%}<p class="form-msg" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <label class="sr" for="pw">Password</label>
      <input class="field" id="pw" type="password" name="password" placeholder="Store password" autocomplete="current-password">
      <button class="btn btn-holo" type="submit">Enter</button>
    {%- endform -%}
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
