<section class="page-hero">
  <div class="wrap">
    <p class="eyebrow dot" style="--acc:var(--white)">Your bag</p>
    <h1 class="display" style="font-size:clamp(40px,6vw,80px)">{% if cart.item_count > 0 %}Nearly <em>yours.</em>{% else %}Your bag is <em>empty.</em>{% endif %}</h1>
  </div>
</section>
<section class="sec" style="padding-top:10px">
  <div class="wrap">
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-page">
        <div class="lines">
          {%- for item in cart.items -%}
            <div class="line">
              {%- if item.image -%}{{ item.image | image_url: width: 160 | image_tag: alt: '' }}{%- endif -%}
              <div>
                <h5><a href="{{ item.url }}" style="text-decoration:none">{{ item.product.title | split: ' | ' | first }}</a></h5>
                {%- unless item.product.has_only_default_variant -%}<small>{{ item.variant.title }}</small>{%- endunless -%}
                <div style="margin-top:8px">
                  <label class="sr" for="u-{{ item.key }}">Quantity</label>
                  <input class="field" style="height:44px;width:90px;flex:none" id="u-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                </div>
              </div>
              <div class="price">{%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>
        <div class="drawer-foot" style="max-width:440px;margin-left:auto">
          {%- liquid
            assign n = cart.item_count
            assign t1q = settings.tier1_qty | default: 3
            assign t1p = settings.tier1_pct | default: 10
            assign t2q = settings.tier2_qty | default: 6
            assign t2p = settings.tier2_pct | default: 15
          -%}
          <p class="meter bundle-meter" style="margin:0">
            {%- if n >= t2q -%}<b class="unlocked">{{ t2p }}% off unlocked</b> · your bundle discount is applied.
            {%- elsif n >= t1q -%}<b class="unlocked">{{ t1p }}% off unlocked</b> · add <b>{{ t2q | minus: n }} more</b> for {{ t2p }}% off.
            {%- else -%}Add <b>{{ t1q | minus: n }} more</b> to save <b>{{ t1p }}%</b> on your order.{%- endif -%}
          </p>
          {%- if cart.total_discount > 0 -%}
            <div class="sub saved-row"><span>Bundle discount</span><b>−{{ cart.total_discount | money }}</b></div>
          {%- endif -%}
          <div class="sub"><span>Subtotal</span><b>{%- if cart.total_discount > 0 -%}<s>{{ cart.original_total_price | money }}</s> {% endif -%}{{ cart.total_price | money }}</b></div>
          <button class="btn btn-ghost" type="submit" name="update">Update bag</button>
          <button class="btn btn-holo" type="submit" name="checkout">Checkout <span class="arr">→</span></button>
          {%- if additional_checkout_buttons -%}<div class="express-pay">{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
          <p class="fine">Buy 3, save 10% · Buy 6+, save 15%. Applied automatically. Delivery is calculated at checkout.</p>
        </div>
      </form>
    {%- else -%}
      <a class="btn btn-holo" href="{{ routes.all_products_collection_url }}">Shop perfume oils <span class="arr">→</span></a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
