<section class="news">
  <div class="wrap">
    <div class="box">
      <div style="display:flex;flex-direction:column;gap:12px">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="display" style="font-size:clamp(32px,4vw,48px)">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2>
        <p class="lead" style="font-size:16px">{{ section.settings.lead }}</p>
      </div>
      {%- form 'customer', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="sr" for="news-email">Email address</label>
        <input class="field" id="news-email" type="email" name="contact[email]" placeholder="you@email.com" autocomplete="email" required>
        <button class="btn btn-holo" type="submit">Sign up</button>
        {%- if form.posted_successfully? -%}
          <p class="form-msg" role="status">Thanks, you're on the list.</p>
        {%- elsif form.errors -%}
          <p class="form-msg" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "New drops first" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the" },
    { "type": "text", "id": "heading_em", "label": "Heading (italic)", "default": "lab list." },
    { "type": "text", "id": "lead", "label": "Text", "default": "New scents, restocks and market dates. No spam." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
