<section class="sec">
  <div class="wrap">
    <div class="sec-head">
      <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2 class="display">{{ section.settings.heading }} <em>{{ section.settings.heading_em }}</em></h2></div>
      {%- if section.settings.lead != blank -%}<p class="lead" style="max-width:36ch">{{ section.settings.lead }}</p>{%- endif -%}
    </div>
    <div class="reviews">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}<a class="review" href="{{ block.settings.link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{%- else -%}<div class="review" {{ block.shopify_attributes }}>{%- endif -%}
          <div class="ph">{% render 'pic', image: block.settings.image, asset: block.settings.asset, alt: block.settings.alt, sizes: '(min-width: 1100px) 20vw, 76vw' %}</div>
          {%- if block.settings.link != blank -%}<span class="play" aria-hidden="true">▶</span>{%- endif -%}
          <div class="note">
            <span class="stars holo-text" style="letter-spacing:3px">★★★★★</span>
            <q>{{ block.settings.quote }}</q>
            <small><b>{{ block.settings.name }}</b> · {{ block.settings.product }}</small>
          </div>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Real reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heard on" },
    { "type": "text", "id": "heading_em", "label": "Heading (italic)", "default": "the street." },
    { "type": "textarea", "id": "lead", "label": "Intro", "default": "We hand people a bottle and film the reaction. Tap a photo to watch it on Instagram." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "asset", "label": "Built-in photo (used when no photo is chosen)" },
        { "type": "text", "id": "alt", "label": "Photo description" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Sandalwoods a banger!" },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer" },
        { "type": "text", "id": "product", "label": "Product", "default": "Perfume oil" },
        { "type": "url", "id": "link", "label": "Video link (Instagram reel)" }
      ]
    }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
